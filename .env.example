# ===========================================
# mallow wallet Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
#
# These are compiled into the binary at build time via --dart-define-from-file;
# .env is NOT a bundled asset. That keeps the file out of the IPA/APK, but the
# VALUES are still recoverable from the compiled snapshot — treat everything
# here as a client-distributed identifier the backend must not trust as a
# bearer credential, not as a secret.
#
# Every value below is OPTIONAL in the sense that the app compiles and the test
# suite passes without any of them. What each one costs you when unset is noted
# per key.
# ===========================================

# ------------------------------------------
# Build target
# ------------------------------------------

# Which deployment tier this build targets: development, staging or production.
# Defaults to production, and an unrecognised value resolves there too.
#
# It is the only variable here whose wrong value is invisible — everything it
# switches keeps working, just against the wrong network:
#
#   solanaRpcUrl        non-production appends ?network=devnet
#   explorer links      non-production append ?cluster=devnet
#   Web3Auth network    non-production uses sapphire_devnet
#   rewards store       non-production reads /store/dev
#
# WARNING: the Web3Auth network is part of the SOCIAL KEY DERIVATION. The same
# social account yields a DIFFERENT ADDRESS on sapphire_devnet than on
# sapphire_mainnet, so this must never change for a deployment once it is live —
# every social wallet would silently become a different wallet.
#
# Leave it at production unless you are pointing the app at a test deployment.
ENV=production

# ------------------------------------------
# Backend
# ------------------------------------------

# Base URL of the API this app talks to. The vendored OpenAPI spec at
# packages/mallow_api/openapi/openapi.yaml is the contract a backend must
# implement. Without it, nothing but local wallet operations works.
# You can also put this in .env.local to keep .env clean.
#
# REQUIRED — there is no compiled-in default for any environment. A backend
# host baked into the binary outlives the build it was right for: a fork that
# forgets this would talk to somebody else's backend without saying so. Unset,
# API calls fail naming this variable.
#
# For a local backend this is typically:
#   API_BASE_URL=http://localhost:8100
API_BASE_URL=

# API key for a mallow-operated backend, sent as the `x-api-key` header — the
# ApiKeyAuth scheme the vendored OpenAPI spec declares.
#
# This is the short path to a running app: instead of implementing the contract
# yourself, request a key and point API_BASE_URL at the base URL issued with it.
# The two are set TOGETHER — neither one alone does anything, and there is no
# compiled-in host, so a key without a base URL still fails naming API_BASE_URL.
#
# Request one in the mallow Discord (https://mallow.art/discord) or by email
# to support@mallow.art.
#
# Unlike the CLIENT_ID_* header, which only says which build is calling, this is
# a spendable credential tied to whoever it was issued to. It is therefore sent
# ONLY to the API_BASE_URL / API_V2_BASE_URL hosts — FIRST_PARTY_HOSTS cannot
# widen that, exactly as it cannot widen where the session cookie goes. Keep it
# out of commits and out of screenshots; a --dart-define value is recoverable
# from the built binary, so treat a shipped key as one you are prepared to have
# read out of an APK.
# MALLOW_API_KEY=

# Base URL of the /v2 surface — the transaction builders and on-chain reads.
# It is a SEPARATE service from /v1, so it gets its own variable.
#
# Unset, it is derived from API_BASE_URL: an http:// base (local development)
# has its port swapped, an https:// base reuses the same host. Set it
# explicitly if your deployment does not follow either shape.
#
# The value must already include the /v2 path segment — the client's own method
# paths omit it. Getting that wrong produces /v2/v2/... and a 404.
# API_V2_BASE_URL=

# Some deployments identify first-party builds with a request header. Set the
# header NAME and the per-platform VALUE your deployment expects. When either
# is blank the header is omitted entirely rather than sent empty.
# CLIENT_ID_HEADER=
# CLIENT_ID_IOS=
# CLIENT_ID_ANDROID=

# Extra hosts this build treats as first-party. Comma-separated, exact host
# match, no wildcards and no ports:
#   FIRST_PARTY_HOSTS=rpc.example.com,pin.example.com
#
# A listed host receives the client-id header above and App-Version — enough to
# tell it which app build is calling, and nothing about who is using it. List
# the hosts you operate: typically your own RPC, gas/simulation and IPFS
# proxies, i.e. whatever RPC_PROXY_BASE_URL and IPFS_UPLOAD_URL point at when
# they point at you.
#
# It does NOT share the user's session. The login token and wallet-signature
# JWTs go to the API_BASE_URL / API_V2_BASE_URL hosts only, and no value here
# can change that.
#
# The API_BASE_URL hosts are always first-party and cannot be removed here;
# this variable only adds. Leave it unset and the app simply never sends those
# headers anywhere but its own backend — a rate-limited proxy, not a leak.
# FIRST_PARTY_HOSTS=

# ------------------------------------------
# Solana RPC — read this one
# ------------------------------------------

# Solana JSON-RPC endpoint. YOU ALMOST CERTAINLY NEED TO SET THIS.
#
# The default is Solana's public MAINNET node (https://api.mainnet-beta.solana.com).
# It is rate-limited, and it does NOT implement the DAS extensions, so it is a
# default that keeps an unconfigured build consistent with everything else here
# — it is not one that makes the app work.
#
# It used to default to the public devnet node, so that a misconfigured build
# landed on devnet rather than transacting on mainnet. That safety net is gone
# by choice: it made the unconfigured build useless for judging the app (devnet
# holds none of your assets, so every screen looked empty for a reason no error
# named), and a wrong-but-harmless default teaches people to skip configuration.
# The consequence is real — an unconfigured build talks to mainnet — and what
# replaces the net is this file plus the README, and the fact that signing still
# needs a funded wallet you control and an unlocked app. Do NOT read that as a
# per-signature prompt: the app lock (cold start, and after 60s in background)
# is the floor, and the per-transaction step-up gate above it is opt-in and OFF
# by default. See "The value gate" in docs/security.md.
#
# Whatever you point this at must implement searchAssets, getAsset, and
# getAssetProof. Without them the portfolio, every NFT list, and every
# compressed-NFT proof come back empty — the app looks broken rather than
# erroring. A stock Solana node, the default above included, does not implement
# them.
#
# Sign up with a DAS-capable provider and use its endpoint here:
#   Helius     https://www.helius.dev
#   Triton     https://triton.one
#   QuickNode  https://www.quicknode.com
# RPC_PROXY_BASE_URL=

# Mainnet-pinned Solana JSON-RPC, used regardless of which cluster the build
# targets. Two features need it: .sol name resolution and native staking, both
# of which only exist on mainnet. Pointed at devnet they fail QUIETLY — an
# unknown domain and an empty stake list are ordinary answers — which is why
# this is separate from RPC_PROXY_BASE_URL.
#
# Defaults to Solana's public mainnet node, which is correct here: these are
# plain account reads with no DAS involved, just rate-limited. Set this to your
# own endpoint to get the throughput back.
# SOLANA_MAINNET_RPC_URL=

# ------------------------------------------
# EVM
# ------------------------------------------

# Ethereum mainnet JSON-RPC for money movement (balance, nonce, estimateGas,
# sendRawTransaction, receipts). Defaults to a public keyless node.
# ETH_RPC_URL=

# Infura Gas API base for the Edit Gas Fee sheet's Low/Market/High tiers.
# REQUIRED for the tiers — no default. Unset, the sheet's Edit affordance is
# hidden and the send is priced from the node's own fee data.
# EVM_GAS_API_URL=

# Endpoint accepting an eth_simulateV1 JSON-RPC call. This is the EVM transfer
# SAFETY GATE: the client simulates the fully-formed transfer and blocks
# signing if anything other than the intended asset would move.
#
# REQUIRED for EVM transfers — no default. It fails CLOSED: unset, or pointed at
# an endpoint that does not implement eth_simulateV1, EVM transfers error out
# rather than proceeding unsimulated. That is deliberate.
# EVM_SIMULATION_URL=

# ------------------------------------------
# Tezos
# ------------------------------------------

# Tezos node RPC. Defaults to a public mainnet node. The node MUST permit the
# run_operation simulation POST the send flow uses to estimate fees.
# TEZOS_RPC_URL=

# ------------------------------------------
# Token data
# ------------------------------------------

# Jupiter API base — swap quotes and execution, token metadata, token search.
# Defaults to Jupiter's public API (https://api.jup.ag). Paths below it match
# Jupiter's own, so a proxy only has to forward. Docs: https://dev.jup.ag
# JUPITER_BASE_URL=

# CoinGecko API base for token prices and charts, called under /api/v3.
# Defaults to the public API, which is rate-limited and carries no paid plan.
# Get a plan key at: https://www.coingecko.com/en/api/pricing
# COINGECKO_BASE_URL=

# Referral-program account (https://referral.jup.ag) that collects the swap
# fee. When unset, swaps run without an integrator fee.
# JUPITER_REFERRAL_ACCOUNT=

# Fallback base URLs inside the jupiter_aggregator package, used ONLY when a
# caller constructs a client without passing baseUrl. This app always passes
# one (JUPITER_BASE_URL, above), so these are inert here — they exist for
# anyone consuming the package standalone. Documented rather than hidden: the
# app reads them, so a reader deserves to know they do nothing for it.
# QUOTE_API_BASE=
# CLASSIC_SWAP_API_BASE=

# ------------------------------------------
# IPFS pinning (NFT mint flow)
# ------------------------------------------

# Endpoint the mint flow uploads media and metadata JSON to. The uploader
# carries no key of its own — it authenticates with the CLIENT_ID_* header
# above, so there is nothing else to configure here.
#
# No default: a pinning endpoint accepts writes, so a compiled-in one would
# have every unconfigured build uploading its users' media into somebody
# else's storage. Unset, the mint flow reports the missing variable.
# IPFS_UPLOAD_URL=

# ------------------------------------------
# Media, CDN and gateways
# ------------------------------------------
#
# Each of these is a host that serves YOUR bandwidth. They default to the
# public upstream each one would proxy, so an unconfigured build works — just
# without your own cache in front of it.

# Origin of an image-resizing CDN implementing
#   /{size}x{size}/{fit}/{url-encoded-source}?quality=N
# and /original/{url-encoded-source}.
#
# Unset, images load from their own origin at full size. Nothing breaks — the
# in-memory decode is still capped at the rendered size — but every thumbnail
# pulls the whole asset, so set this if you run a resizer.
# IMAGE_CDN_BASE_URL=

# Origin of a static asset CDN, used for two things: rewards-store metadata
# under /store (and /store/dev off production), and the operator feeds
# /status.json and /notification-v2.json that drive the maintenance and
# broadcast banners.
#
# Unset, the rewards store has no metadata and the banners never show. Both
# already fail safe when a feed does not answer.
# ASSET_CDN_BASE_URL=

# An additional IPFS gateway to race in the asset fallback ladder.
#
# NOT the primary resolver. An ipfs:// source always resolves through the
# public ipfs.io first — that string is the image CDN's cache key and has to
# match what the web client emits — and every render goes through the CDN
# before any gateway is contacted directly. This host is only tried when that
# fails, in the video and download ladders.
#
# Defaults to ipfs.io, which makes the extra rung a no-op. Set it to a gateway
# that reliably holds your pinned CIDs to buy a retry between ipfs.io and
# dweb.link; leave it unset to keep the app off your own gateway entirely.
#
# The gateway written into MINTED metadata is not configurable: it is always
# ipfs.io, because that URL goes on-chain and must resolve for every client
# forever, not just for this deployment.
# IPFS_GATEWAY_URL=

# Arweave gateway used as the mirror when the asset's own gateway refuses the
# fetch — arweave.net 403s particular clients and regions for data it serves
# fine elsewhere. Defaults to arweave.net itself, which makes the mirror step
# a no-op rather than a second host to trust.
# ARWEAVE_GATEWAY_URL=

# Origin of a DiceBear-compatible identicon service for generated avatars,
# called as /10.x/identicon/svg?seed=…. Defaults to DiceBear's public API.
# AVATAR_SERVICE_URL=

# ------------------------------------------
# Chromecast
# ------------------------------------------

# Cast receiver application id — the HTML receiver the Cast SDK launches on
# the TV, registered in the Google Cast Developer Console.
#
# Defaults to mallow's own receiver, so casting works out of the box. That is
# fine for evaluating the app and WRONG for a fork you distribute: every one of
# your users would be casting into mallow's receiver, on mallow's bandwidth and
# under mallow's branding. Register your own and set it here.
#
# Not a secret — a sender broadcasts it on the local network. Unlike the URLs
# above, it has no useful empty state: the SDK rejects a blank id, so leaving
# this unset keeps the default rather than disabling casting.
#
# Android reads it at BUILD time (the Cast SDK constructs its options provider
# from AndroidManifest.xml before any Dart runs, so android/app/build.gradle.kts
# decodes this define into a manifest entry); iOS reads it at RUNTIME over the
# cast method channel. One variable either way.
# CAST_RECEIVER_APP_ID=

# ------------------------------------------
# Social sign-in
# ------------------------------------------

# Web3Auth client ID, from the MetaMask Embedded Wallets dashboard. One project
# per environment: dev/staging on sapphire_devnet, production on
# sapphire_mainnet. Get one at: https://dashboard.web3auth.io
# WEB3AUTH_CLIENT_ID=

# ------------------------------------------
# Media
# ------------------------------------------

# Emit asset URLs in canonical `ipfs://` / `ar://` form inside the image-resize
# path, instead of the gateway form. Off unless set to true/1.
# CANONICAL_ASSET_URLS=

# ------------------------------------------
# Analytics & error tracking
# ------------------------------------------

# Analytics is on by default; set to false to hard-disable a build. Events are
# forwarded to the backend, which holds the analytics provider's credentials —
# there is no client-side analytics token.
# ANALYTICS_ENABLED=true

# Sentry DSN for error tracking. Without it, no crash reports are sent.
# Get one at: https://sentry.io
# SENTRY_DSN=
