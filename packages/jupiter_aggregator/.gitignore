# Files and directories created by pub.
.dart_tool/
.packages

# Conventional directory for build outputs.
build/

# pubspec.lock IS committed here, against the usual library-package advice
# (https://dart.dev/guides/libraries/private-files#pubspeclock). This is a path
# package consumed only by this repository's app, and CI runs its test suite —
# without a lock, an upstream release re-resolves on every run and can turn open
# pull requests red with no code change.
